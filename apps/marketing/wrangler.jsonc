{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mend-marketing",
  "compatibility_date": "2026-03-28",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  // Decided 2026-08-28: mend.run is Mend's own domain and the primary address for the
  // marketing site; docs live at docs.mend.run (apps/docs). The original
  // mend.sealant.dev stays alive as-is (install.sh links point there), but nothing
  // new lands under sealant.dev. Wrangler creates each DNS record in its zone on deploy.
  "routes": [
    { "pattern": "mend.run", "custom_domain": true },
    { "pattern": "mend.sealant.dev", "custom_domain": true },
  ],
  "observability": {
    "enabled": true,
  },
}
