{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "mend-marketing",
  "compatibility_date": "2026-03-28",
  "compatibility_flags": ["nodejs_compat"],
  "main": "@tanstack/react-start/server-entry",
  // Decided 2026-08-02: Mend lives under the platform's domain. Wrangler creates the
  // DNS record in the sealant.dev zone on deploy.
  "routes": [{ "pattern": "mend.sealant.dev", "custom_domain": true }],
  "observability": {
    "enabled": true,
  },
}
