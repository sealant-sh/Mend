{
  "name": "@sealant/mend",
  "version": "0.15.1",
  "description": "The mend CLI: adopt a repository into Mend's store, launch your coding agent in a recorded session worktree, detach and reattach from any terminal",
  "keywords": [
    "claude-code",
    "codex",
    "coding-agent",
    "mend",
    "sealant",
    "session",
    "worktree"
  ],
  "homepage": "https://github.com/sealant-sh/Mend",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sealant-sh/Mend.git",
    "directory": "apps/cli"
  },
  "bin": {
    "mend": "./dist/main.js"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "tsc src/main.ts src/dashboard.tsx --outDir dist --module nodenext --target es2023 --types node --skipLibCheck --allowImportingTsExtensions --rewriteRelativeImportExtensions --jsx react-jsx --jsxImportSource @opentui/react",
    "lint": "oxlint . --no-error-on-unmatched-pattern",
    "prepack": "pnpm run build",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsgo -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@opentui/core": "^0.5.1",
    "@opentui/react": "^0.5.1",
    "@tanstack/react-query": "catalog:",
    "qrcode": "catalog:",
    "react": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@mend/typescript": "workspace:*",
    "@types/node": "catalog:",
    "@types/qrcode": "catalog:",
    "@types/react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=22"
  }
}
