# Copy to `.env` at the repo root — `pnpm dev` loads it (explicit shell env
# always wins over these). Full reference: DEVELOPMENT.md §Environment.

# The Sealant control plane. A local `~/.sealant` stack serves 4000; without
# this the SDK defaults to localhost:8080 and session launches fail.
SEALANT_BASE_URL=http://localhost:4000

# Mend's service key on that control plane (one of its SEALANT_SERVICE_KEYS).
# Mend authenticates as a service principal and acts on behalf of each
# signed-in user under their own Sealant user — provisioned on first use, no
# Sealant web login needed (docs/SEALANT-IDENTITY.md). A local stack with
# SEALANT_SERVICE_KEYS unset is open and needs none.
# SEALANT_SERVICE_KEY=
