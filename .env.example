# Copy to `.env` at the repo root — `pnpm dev` loads it (explicit shell env
# always wins over these). Full reference: DEVELOPMENT.md §Environment.

# The Sealant control plane. A local `~/.sealant` stack serves 4000; without
# this the SDK defaults to localhost:8080 and session launches fail.
SEALANT_BASE_URL=http://localhost:4000

# The user id your Sealant web UI writes connected accounts under — the SDK
# default (usr_local) owns nothing. Find yours:
#   SELECT owner_user_id FROM connected_accounts;   -- sealant_control_plane DB
SEALANT_OWNER_USER_ID=

# Bearer for authenticated Sealant deployments; a local stack needs none.
# SEALANT_API_KEY=
